# Base URL of the Laravel API, including the version prefix.
#
# SERVER-ONLY: deliberately not prefixed with NEXT_PUBLIC_. The browser never
# talks to Laravel directly -- it calls this app's own /api routes, which attach
# the bearer token server-side (the BFF pattern, ARCHITECTURE-V1.md 3.4).
#
# Because the Next.js server and Laravel both run inside WSL, plain localhost
# works here even though a Windows browser cannot reach it.
API_BASE_URL=http://localhost:8000/api/v1
